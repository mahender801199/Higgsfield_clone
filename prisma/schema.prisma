// Lumora Studio — Prisma schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Auth (NextAuth) models
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Billing & credits
  credits          Int     @default(50) // starter credits granted on signup
  stripeCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  generations       Generation[]
  referenceElements ReferenceElement[]
  characters        Character[]
  creditTxns        CreditTxn[]
  subscriptions     Subscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// Core domain models
// ─────────────────────────────────────────────

enum GenerationType {
  IMAGE
  VIDEO
  AUDIO
  UPSCALE
  BG_REMOVAL
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Generation {
  id          String           @id @default(cuid())
  userId      String
  type        GenerationType
  model       String // model slug, e.g. "fal-ai/flux/dev"
  status      GenerationStatus @default(QUEUED)
  inputParams Json
  outputUrl   String?
  thumbnailUrl String?
  error       String?
  creditCost  Int              @default(0)
  jobId       String? // BullMQ job id, set in later phases
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([status])
}

// Reusable uploaded reference elements (character/product/object)
model ReferenceElement {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String? // e.g. "character", "product", "object", "style"
  imageUrls String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Character consistency ("Soul"-style) — v1 image conditioning, v2 LoRA
model Character {
  id          String   @id @default(cuid())
  userId      String
  name        String
  imageUrls   String[]
  loraUrl     String? // populated when v2 fine-tuning is used
  trainingId  String? // training job reference (v2)
  status      String   @default("ready") // "ready" | "training" | "failed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreditTxn {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // positive = grant/top-up, negative = spend
  reason    String // e.g. "signup_bonus", "generation:image", "stripe_topup"
  balance   Int? // resulting balance snapshot (optional)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  stripeSubId String   @unique
  plan        String // e.g. "starter", "pro", "studio"
  status      String // e.g. "active", "canceled", "past_due"
  currentPeriodEnd DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Curated prompt templates + style modifiers (the "preset library")
model Preset {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  category    String // e.g. "portrait", "cinematic", "product", "anime"
  type        GenerationType @default(IMAGE)
  promptTemplate String  @db.Text // may include {{subject}} placeholders
  negativePrompt String? @db.Text
  modifiers   Json? // model params: aspect ratio, steps, guidance, etc.
  thumbnailUrl String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([type])
}
