{
  "name": "lumora-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Lumora Studio — a multi-model AI image & video generation platform for creators and marketers.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
