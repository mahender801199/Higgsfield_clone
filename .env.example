# ─────────────────────────────────────────────────────────────
# Lumora Studio — environment variables
# Copy to `.env` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumora?schema=public"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email provider (magic-link sign in). Use any SMTP server.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Lumora <no-reply@lumora.studio>"

# ─── The following are NOT needed for Phase 1, added in later phases ───

# Redis (BullMQ job queue) — Phase 5+
# REDIS_URL="redis://localhost:6379"

# AI model aggregators — wire up when implementing generation (Phase 2)
# FAL_KEY=""
# REPLICATE_API_TOKEN=""

# Voice (ElevenLabs) — Phase 8
# ELEVENLABS_API_KEY=""

# Cloudflare R2 storage — Phase 2+
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_URL=""

# Stripe billing — Phase 3
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
